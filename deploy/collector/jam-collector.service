[Unit]
Description=Virtual Jam Central Beta Log Collector
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=jamcollector
Group=jamcollector
Environment=JAM_COLLECTOR_BIND=127.0.0.1:8080
Environment=JAM_COLLECTOR_STORAGE_DIR=/var/log/jam-collector
Environment=JAM_COLLECTOR_RATE_LIMIT=30
Environment=JAM_COLLECTOR_RETENTION_DAYS=30
Environment=JAM_COLLECTOR_MAX_DISK_MB=2048
EnvironmentFile=-/etc/virtual-jam/collector.env
ExecStart=/usr/local/lib/virtual-jam/jam-collector
Restart=always
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0027
ReadWritePaths=/var/log/jam-collector
LimitNOFILE=1024
TasksMax=64
MemoryMax=128M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
